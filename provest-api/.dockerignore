# Dependencies — rebuilt inside Docker
vendor/
node_modules/

# Environment — injected at runtime via env_file
.env
.env.*

# Tests — not needed in production image
tests/
.phpunit.cache/
phpunit.xml

# Git
.git/
.github/
.gitignore
.gitattributes

# Documentation
*.md
CLAUDE.md

# Vite / frontend build artifacts (Laravel has its own vite.config.js scaffolding)
public/build/
public/hot

# Cached application files — generated at runtime
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
