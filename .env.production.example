# =============================================================================
# Provest — فایل تنظیمات محیط تولید (Production Environment)
#
# روش استفاده:
#   cp .env.production.example .env.production
#   nano .env.production   ← مقادیر واقعی را وارد کنید
#
# این یک فایل واحد است که هم توسط Docker Compose (برای PostgreSQL)
# و هم توسط Laravel (تمام تنظیمات برنامه) استفاده می‌شود.
# =============================================================================

# ─── دیتابیس PostgreSQL ───────────────────────────────────────────────────────
# این سه متغیر هم توسط کانتینر PostgreSQL و هم Laravel خوانده می‌شوند.
# DB_PASSWORD را با یک رمز عبور قوی و تصادفی جایگزین کنید.

DB_DATABASE=provest
DB_USERNAME=provest_user
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD


# =============================================================================
# تنظیمات Laravel
# =============================================================================

# نام برنامه — در ایمیل‌ها، لاگ‌ها و عنوان صفحه نمایش داده می‌شود
APP_NAME=Provest

# محیط اجرا — در سرور همیشه باید production باشد
APP_ENV=production

# کلید رمزنگاری — حتماً با دستور زیر یک کلید منحصربه‌فرد بسازید:
#   docker compose --env-file .env.production -f docker-compose.prod.yml \
#     exec laravel php artisan key:generate --show
# خروجی را کپی کرده و جای این مقدار قرار دهید.
APP_KEY=

# در محیط تولید باید false باشد تا اطلاعات حساس به کاربر نمایش داده نشود
APP_DEBUG=false

# آدرس کامل سایت (بدون اسلش انتهایی)
APP_URL=https://provest.ir

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# تعداد دور bcrypt برای هش رمز عبور — 12 مقدار مناسبی برای تولید است
BCRYPT_ROUNDS=12


# ─── اتصال دیتابیس در Laravel ─────────────────────────────────────────────────
# DB_HOST باید نام سرویس Docker باشد نه 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432


# ─── لاگ‌گیری ──────────────────────────────────────────────────────────────────
# در محیط تولید فقط خطاهای سطح error و بالاتر ثبت می‌شوند
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error


# ─── Session (نشست کاربری) ─────────────────────────────────────────────────────
# ذخیره session در دیتابیس امن‌تر از cookie است
SESSION_DRIVER=database
# مدت زمان اعتبار session به دقیقه
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# دامنه‌ای که session برای آن معتبر است
SESSION_DOMAIN=provest.ir


# ─── صف پردازش (Queue) و کش ────────────────────────────────────────────────────
# هر دو از دیتابیس PostgreSQL استفاده می‌کنند؛ نیاز به Redis نیست
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database


# ─── Redis (اختیاری) ───────────────────────────────────────────────────────────
# اگر Redis نصب ندارید این بخش را تغییر ندهید
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# ─── ایمیل ──────────────────────────────────────────────────────────────────────
# log: ایمیل‌ها فقط در فایل لاگ ثبت می‌شوند (برای تست)
# برای ارسال واقعی: MAIL_MAILER=smtp و اطلاعات SMTP سرویس خود را وارد کنید
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# آدرس فرستنده ایمیل‌های سیستمی
MAIL_FROM_ADDRESS="noreply@provest.ir"
MAIL_FROM_NAME="${APP_NAME}"


# ─── AbanTether (درگاه پرداخت ارز دیجیتال) ────────────────────────────────────
# توکن API از پنل کاربری AbanTether دریافت می‌شود
ABANTETHER_API_TOKEN=YOUR_ABANTETHER_API_TOKEN_HERE
ABANTETHER_API_BASE=https://api.abantether.com
# ارز پایه برای واریز — در حال حاضر USDT
ABANTETHER_DEPOSIT_COIN=USDT
# شبکه پیش‌فرض برای واریز
ABANTETHER_DEFAULT_NETWORK=TRC20


# ─── AWS S3 (اختیاری) ──────────────────────────────────────────────────────────
# فقط اگر از S3 برای ذخیره فایل استفاده می‌کنید این بخش را پر کنید
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
