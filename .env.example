# =============================================================================
# Docker Compose — root environment file
# Copy to .env and fill in values before running docker compose.
#
# These three variables are shared between:
#   - the postgres container  (POSTGRES_* mapped from DB_*)
#   - provest-api/.env        (DB_* must match exactly)
# =============================================================================

DB_DATABASE=provest
DB_USERNAME=provest_user
DB_PASSWORD=change_me_strong_password
